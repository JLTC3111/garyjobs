{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/vacancy.js": { "includeFiles": "dist/index.html" } },
  "rewrites": [
    { "source": "/jobs/:slug", "destination": "/api/vacancy?slug=:slug" }
  ]
}
